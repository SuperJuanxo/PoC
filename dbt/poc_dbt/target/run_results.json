 "started_at": "2026-09-01T11:18:27.522013Z", "completed_at": "2026-09-01T11:18:27.522013Z"}, {"name": "execute", "started_at": "2026-09-01T11:18:27.522013Z", "completed_at": "2026-09-01T11:18:27.522013Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.poc_dbt.int__socis_nif_dup", "compiled": true, "compiled_code": "\n\nWITH BASE AS (\n\n    SELECT *\n    FROM \"dev\".\"main\".\"stg__socis_completa\"\n    WHERE NIF IS NOT NULL\n        AND LEFT(NIF, 8) <> REPEAT(LEFT(NIF, 1), 8)\n        AND LEFT(NIF, 7) <> '0000000'\n        AND LEFT(NIF, 8) <> ' 000000'\n        AND NIF <> ''\n\n),\n\nSOCI_DUP AS (\n\n    SELECT\n        Soci,\n        NIF\n    FROM BASE\n    GROUP BY\n        Soci,\n        NIF\n\n),\n\nNIF_REUSED AS (\n\n    SELECT\n        NIF,\n        COUNT(*) AS Qty_NIF\n    FROM SOCI_DUP\n    GROUP BY NIF\n    HAVING COUNT(*) > 1\n\n),\n\nSOCI_REUSED AS (\n\n    SELECT\n        Soci,\n        COUNT(*) AS Qty_NIF\n    FROM SOCI_DUP\n    GROUP BY Soci\n    HAVING COUNT(*) > 1\n\n),\n\nSA AS (\n\n    SELECT\n        s.Soci,\n        s.NIF,\n        s.DataAlta,\n        s.DataBaixa,\n        s.Situacio,\n\n        mtr.Id AS Cliente_Id,\n\n        ROW_NUMBER() OVER (\n            PARTITION BY mtr.Id\n            ORDER BY\n                DataAlta,\n                COALESCE(DataBaixa, DATE '9999-12-31')\n        )\n\n        -\n\n        ROW_NUMBER() OVER (\n            PARTITION BY mtr.Id, NIF\n            ORDER BY\n                DataAlta,\n                COALESCE(DataBaixa, DATE '9999-12-31')\n        ) AS rn\n\n    FROM BASE s\n\n    LEFT JOIN \"dev\".\"main\".\"stg__masters\" mtr\n        ON mtr.Tabla = 'Clientes'\n       AND mtr.Codigo_PG = s.Soci\n\n),\n\nULTIMA_FILA_ISLA AS (\n\n    SELECT\n        *,\n\n        ROW_NUMBER() OVER (\n            PARTITION BY Cliente_Id, NIF, rn\n            ORDER BY\n                DataAlta DESC,\n                COALESCE(DataBaixa, DATE '9999-12-31') DESC\n        ) AS rn_last\n\n    FROM SA\n\n),\n\nFINAL_PROPUESTA AS (\n\n    SELECT\n        Soci,\n        Cliente_Id,\n        NIF,\n        rn,\n        DataAlta,\n        DataBaixa,\n        Situacio\n\n    FROM ULTIMA_FILA_ISLA\n\n    WHERE rn_last = 1\n\n),\n\nFINAL_GROUP AS (\n\n    SELECT\n        a.*,\n\n        CASE\n            WHEN nr.NIF IS NOT NULL\n             AND sr.Soci IS NOT NULL\n                THEN 'Ambos casos'\n\n            WHEN nr.NIF IS NOT NULL\n                THEN 'DNI en varios Socis'\n\n            WHEN sr.Soci IS NOT NULL\n                THEN 'Soci con varios NIF'\n        END AS Descripcion_del_caso\n\n    FROM FINAL_PROPUESTA a\n\n    LEFT JOIN NIF_REUSED nr\n        ON nr.NIF = a.NIF\n\n    LEFT JOIN SOCI_REUSED sr\n        ON sr.Soci = a.Soci\n\n    WHERE\n        nr.NIF IS NOT NULL\n        OR sr.Soci IS NOT NULL\n\n),\n\nFINAL_NIF AS (\n\n    SELECT *\n    FROM FINAL_GROUP\n\n    WHERE Descripcion_del_caso IN (\n        'DNI en varios Socis',\n        'Ambos casos'\n    )\n\n)\n\nSELECT *\nFROM FINAL_NIF", "relation_name": "\"dev\".\"main\".\"int__socis_nif_dup\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-09-01T11:18:27.522013Z", "completed_at": "2026-09-01T11:18:27.522013Z"}, {"name": "execute", "started_at": "2026-09-01T11:18:27.522013Z", "completed_at": "2026-09-01T11:18:27.522013Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.0, "adapter_response": {}, "message": null, "failures": null, "unique_id": "model.poc_dbt.int__socis_unics", "compiled": true, "compiled_code": "\n\nWITH BASE AS (\n\n    SELECT *\n    FROM \"dev\".\"main\".\"stg__socis_completa\"\n    WHERE NIF IS NOT NULL\n\n        /*\n        Elimina DNIs tipo:\n        00000000T\n        11111111A\n        99999999R\n        */\n\n        AND LEFT(NIF, 8) <> REPEAT(LEFT(NIF, 1), 8)\n        AND LEFT(NIF, 7) <> '0000000'\n        AND LEFT(NIF, 8) <> ' 000000'\n        AND NIF <> ''\n\n),\n\nSOCI_NIF AS (\n\n    SELECT\n        Soci,\n        NIF\n    FROM BASE\n    GROUP BY\n        Soci,\n        NIF\n\n),\n\nNIF_SIMPLE AS (\n\n    SELECT\n        NIF,\n        COUNT(*) AS Qty_NIF\n    FROM SOCI_NIF\n    GROUP BY NIF\n    HAVING COUNT(*) = 1\n\n),\n\nSOCI_SIMPLE AS (\n\n    SELECT\n        Soci,\n        COUNT(*) AS Qty_NIF\n    FROM SOCI_NIF\n    GROUP BY Soci\n    HAVING COUNT(*) = 1\n\n),\n\nsa AS (\n\n    SELECT\n        s.Soci,\n        s.NIF,\n        s.DataAlta,\n        s.DataBaixa,\n        s.Situacio,\n\n        mtr.Id AS Cliente_Id,\n\n        ROW_NUMBER() OVER (\n            PARTITION BY mtr.Id\n            ORDER BY\n                DataAlta,\n                COALESCE(DataBaixa, DATE '9999-12-31')\n        )\n\n        -\n\n        ROW_NUMBER() OVER (\n            PARTITION BY mtr.Id, NIF\n            ORDER BY\n                DataAlta,\n                COALESCE(DataBaixa, DATE '9999-12-31')\n        ) AS rn\n\n    FROM BASE s\n\n    LEFT JOIN \"dev\".\"main\".\"stg__masters\" mtr\n        ON mtr.Tabla = 'Clientes'\n       AND mtr.Codigo_PG = s.Soci\n\n),\n\nultima_fila_isla AS (\n\n    SELECT\n        *,\n\n        ROW_NUMBER() OVER (\n            PARTITION BY Cliente_Id, NIF, rn\n            ORDER BY\n                DataAlta DESC,\n                COALESCE(DataBaixa, DATE '9999-12-31') DESC\n        ) AS rn_last\n\n    FROM sa\n\n),\n\nFINAL_PROPUESTA AS (\n\n    SELECT\n        Soci,\n        Cliente_Id,\n        NIF,\n        rn,\n        DataAlta,\n        DataBaixa,\n        Situacio\n\n    FROM ultima_fila_isla\n\n    WHERE rn_last = 1\n\n),\n\nFINAL_GROUP AS (\n\n    SELECT\n        a.*,\n\n        'OK' AS Descripcion_del_caso\n\n    FROM FINAL_PROPUESTA a\n\n    LEFT JOIN NIF_SIMPLE nr\n        ON nr.NIF = a.NIF\n\n    LEFT JOIN SOCI_SIMPLE sr\n        ON sr.Soci = a.Soci\n\n    WHERE\n        nr.NIF IS NOT NULL\n        AND sr.Soci IS NOT NULL\n\n)\n\nSELECT *\nFROM FINAL_GROUP", "relation_name": "\"dev\".\"ma